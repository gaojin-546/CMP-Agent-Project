# ============================================================================
#  CMP-Agent-Project —— 开源仓库忽略规则
#  原则：**宁可多忽略**。任何密钥、真实实验数据、本地模型、向量库都不进仓库。
# ============================================================================

# ---- 密钥与本地配置（最重要）----
*.env
.env
.env.*
!.env.example
*.key
*.pem
secrets.toml
.streamlit/secrets.toml

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.ipynb_checkpoints/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 日志 ----
logs/
*.log
*.log.*

# ---- 真实实验数据（保留目录结构与模板，数据本身不入库）----
data/projects/*
!data/projects/.gitkeep
!data/projects/README.md
data/raw/
data/processed/
data/*.xlsx
data/*.csv
!data/template.csv
!data/template.xlsx
artifacts/
runs/
outputs/
*.sqlite3
*.db

# ---- RAG 本地向量库 / 台账镜像（真实库在仓库之外）----
data/rag/
private_kb/
private_rag_cmp/
chroma_db/
chroma.sqlite3
*.chroma
kb_record.json

# ---- 本地大模型权重（2.27 GB BGE-M3，绝不入库）----
model/
models/
*.bin
*.safetensors
*.onnx
*.gguf
*.pt
*.pth
*.ckpt
pytorch_model*

# ---- 运行产物与临时文件 ----
streamlit.log
selfcheck.txt
_tree.txt
_vendor/
_wheels/
*.tmp
*.bak
*.swp
.acl-recovery/
.dsh-write-probe

# ---- 编辑器 / 操作系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
