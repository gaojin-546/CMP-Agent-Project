# ============================================================================
# 复制为 .env 后填写。.env 已在 .gitignore 中，不会进版本库。
# ============================================================================

# ---- DeepSeek 大模型（必填）----
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- RAG 微服务地址（网页端通过 HTTP 调用）----
RAG_SERVICE_URL=http://127.0.0.1:8770
RAG_PORT=8770

# ---- 原始 RAG 资产（绝对路径；BGE-M3 有 2.3 GB，不要复制进本项目）----
RAG_KB_DIR=E:/private_rag_cmp/private_kb
RAG_RECORD_FILE=E:/private_rag_cmp/kb_record.json
RAG_MODEL_DIR=E:/private_rag_cmp/model/bge-m3
RAG_ARCHIVE_DIR=E:/private_rag_cmp/summary_archive
RAG_COLLECTION=langchain

# ---- 切片策略（化工文献：大 chunk 保住配方完整性）----
RAG_CHUNK_SIZE=1800
RAG_CHUNK_OVERLAP=300

# ---- 检索 ----
RAG_TOP_K=4
RAG_RETRIEVE_MULTIPLIER=2
